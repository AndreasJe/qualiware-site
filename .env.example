# =============================================================================
# QualiWare site — environment template
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real values.
# On the server, restrict the file to the service user (chmod 600).
#
# Note: this is a dotenv file, not JSON — Next.js and Payload both read
# environment variables, so a .json config would not be picked up.
# =============================================================================


# --- Database ---------------------------------------------------------------
# The adapter is chosen by the scheme. Anything starting `postgres` selects
# Postgres; anything else falls back to SQLite.
#
# SQLite is for local development only. It locks the whole file for a write, so
# one process blocks every other writer — with several editors that is constant.
# Local development runs Postgres in Docker:
#
#   docker run -d --name qualiware-postgres \
#     -e POSTGRES_USER=qualiware \
#     -e POSTGRES_PASSWORD=qualiware-dev \
#     -e POSTGRES_DB=qualiware \
#     -p 5432:5432 \
#     -v qualiware-pgdata:/var/lib/postgresql/data \
#     --restart unless-stopped \
#     postgres:17-alpine
DATABASE_URI=postgres://qualiware:qualiware-dev@127.0.0.1:5432/qualiware
# DATABASE_URI=file:./qualiware.db   # SQLite fallback — single writer, dev only


# --- Application ------------------------------------------------------------
# Signs session tokens. Generate a fresh one per environment:
#   openssl rand -base64 48
# Rotating it invalidates every existing session, so do it before launch.
PAYLOAD_SECRET=CHANGE_ME_generate_a_long_random_value

# Payload builds absolute links from this — most importantly the password reset
# link it emails. Wrong here means a reset email that delivers a broken link.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# NEXT_PUBLIC_SERVER_URL=https://qualiware.com


# --- Properties -------------------------------------------------------------
# One variable moves all four properties. Locally the sub-hosts resolve without
# any hosts-file entry: docs.localhost:3000, partners.localhost:3000, and so on.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# NEXT_PUBLIC_ROOT_DOMAIN=qualiware.com

# `subdomain` (default) or `path`. Use `path` only where wildcard DNS is
# unavailable — properties are then served at /docs, /partners, /support.
# NEXT_PUBLIC_TENANT_MODE=subdomain

# Lets one sign-in span all four properties. Unset locally on purpose:
# browsers do not share cookies across `.localhost` subdomains.
# SESSION_COOKIE_DOMAIN=.qualiware.com


# --- Environment behaviour --------------------------------------------------
# Dead links land on a "Doesn't exist in this prototype" page instead of a bare
# 404. Set to false in production.
NEXT_PUBLIC_PROTOTYPE_MODE=true

# false switches every property to `Disallow: /`. Set it on ANY review or
# staging deployment — a staging copy competing with the real site in search
# results is expensive to undo.
# NEXT_PUBLIC_ALLOW_INDEXING=false


# --- Email ------------------------------------------------------------------
# Without SMTP_HOST, Payload writes mail to the console, which means password
# reset silently does nothing. Required before real users exist.
# SMTP_HOST=smtp.zoho.eu
# SMTP_PORT=587
# SMTP_USER=no-reply@qualiware.com
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM_ADDRESS=no-reply@qualiware.com
# SMTP_FROM_NAME=QualiWare


# --- Zoho Desk (EU data centre) ---------------------------------------------
# Powers help-centre search and case creation on the support property.
# Everything degrades gracefully when unset: the page renders, shows a
# "Preview mode" note, and stores submissions locally instead of creating
# tickets. Verify scopes and endpoints against Zoho's current documentation
# before pointing this at the live desk.
# ZOHO_DESK_ORG_ID=CHANGE_ME
# ZOHO_DESK_CLIENT_ID=CHANGE_ME
# ZOHO_DESK_CLIENT_SECRET=CHANGE_ME
# ZOHO_DESK_REFRESH_TOKEN=CHANGE_ME
# ZOHO_DESK_DEPARTMENT_ID=CHANGE_ME

# Where the SUPPORT link points until the support property replaces it.
# NEXT_PUBLIC_SUPPORT_URL=https://support.qualiware.com


# --- Deliberately not set here ----------------------------------------------
#
# NODE_ENV
#   Set by Next.js itself. Do not set it by hand — the build and start scripts
#   handle it, and overriding it causes hard-to-spot behaviour differences.
#
# PAYLOAD_COOKIE_PREFIX
#   No longer used. The end-user session now reads the prefix from the running
#   Payload config, so the two can never disagree. Change cookiePrefix in
#   src/payload.config.ts if you need a different one.
